{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyyo.one/schemas/oyyo-manifest-1.0.schema.json",
  "title": "OYYO Package Manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "kind", "artifacts", "capabilities", "license", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"enum": ["model", "bundle", "adapter"]},
    "description": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "properties": {
          "path": {"type": "string"},
          "format": {"type": "string"},
          "sha256": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "hardware": {"type": "object"},
    "quantization": {"type": ["string", "null"]},
    "context_length": {"type": ["integer", "null"], "minimum": 1},
    "license": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "url": {"type": "string"}}, "additionalProperties": true},
    "provenance": {"type": "object"},
    "benchmark": {"type": "object"}
  },
  "additionalProperties": true
}
